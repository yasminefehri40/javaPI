<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="700.0" minWidth="1200.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="otemps.controllers.ObjetController">

    <style>
        .admin-header {
        -fx-background-color: #2c2c2c;
        -fx-padding: 20;
        -fx-spacing: 10;
        }

        .admin-title {
        -fx-font-size: 24;
        -fx-font-weight: bold;
        -fx-text-fill: #c5a059;
        }

        .btn-primary {
        -fx-background-color: #c5a059;
        -fx-text-fill: white;
        -fx-padding: 8 15;
        -fx-cursor: hand;
        }

        .btn-primary:hover {
        -fx-background-color: #b8963f;
        }
    </style>

    <top>
        <VBox styleClass="admin-header">
            <HBox spacing="10" style="-fx-alignment: center-left;">
                <Label text="Gestion des Objets" styleClass="admin-title" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAjouter" text="Nouvel Objet" onAction="#handleAjouter"
                        styleClass="btn-primary" />
            </HBox>

            <HBox spacing="10" style="-fx-padding: 15 0 0 0;">
                <TextField fx:id="tfRecherche" promptText="Rechercher..." HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="cbCategorie" promptText="Categorie" prefWidth="200" />
                <Button text="Filtrer" onAction="#handleFiltrer" styleClass="btn-primary" />
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableObjets" style="-fx-font-size: 11;">
            <columns>
                <TableColumn fx:id="colNom" text="Nom" prefWidth="240" />
                <TableColumn fx:id="colCategorie" text="Categorie" prefWidth="190" />
                <TableColumn fx:id="colEpoque" text="Epoque" prefWidth="190" />
                <TableColumn fx:id="colOrigine" text="Origine" prefWidth="190" />
                <TableColumn fx:id="colActions" text="Actions" prefWidth="180" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-alignment: center-right;">
            <Label fx:id="lblTotal" text="Total: 0 objets" style="-fx-text-fill: #666;" HBox.hgrow="ALWAYS" />
            <Button text="Retour" onAction="#handleRetour" styleClass="btn-primary" />
        </HBox>
    </bottom>
</BorderPane>
