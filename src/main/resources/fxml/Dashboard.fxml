<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="900.0" minWidth="1400.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="otemps.controllers.AdminDashboardController"
            style="-fx-background-color: #f4f6fb;">

    <left>
        <VBox prefWidth="290.0" spacing="28.0" style="-fx-background-color: #131c31; -fx-padding: 22 16 18 16;">
            <children>
                <VBox spacing="2.0" style="-fx-padding: 12 18 28 18;">
                    <children>
                        <ImageView fitHeight="122.0" fitWidth="170.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/otemps-logo.jfif" />
                            </image>
                        </ImageView>
                        <Label text="Admin Panel" style="-fx-font-size: 20; -fx-text-fill: #c5b08b; -fx-font-family: 'Segoe UI'; -fx-padding: 6 0 0 6;" />
                    </children>
                </VBox>

                <VBox spacing="14.0">
                    <children>
                        <Button text="Collections" onAction="#handleCategories"
                                maxWidth="Infinity"
                                style="-fx-background-color: #37ace8; -fx-text-fill: white; -fx-font-size: 18; -fx-padding: 16 18; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT;" />
                        <Button text="Objets" onAction="#handleObjets"
                                maxWidth="Infinity"
                                style="-fx-background-color: transparent; -fx-text-fill: #9aa6c2; -fx-font-size: 18; -fx-padding: 14 18; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT;" />
                        <Button text="Medias" onAction="#handleMedias"
                                maxWidth="Infinity"
                                style="-fx-background-color: transparent; -fx-text-fill: #9aa6c2; -fx-font-size: 18; -fx-padding: 14 18; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT;" />
                        <Button text="Statistiques" onAction="#handleReports"
                                maxWidth="Infinity"
                                style="-fx-background-color: transparent; -fx-text-fill: #9aa6c2; -fx-font-size: 18; -fx-padding: 14 18; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT;" />
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="10.0" style="-fx-padding: 0 12 0 12;">
                    <children>
                        <Label text="Systeme" style="-fx-text-fill: #4de3a2; -fx-font-size: 16; -fx-font-family: 'Segoe UI Semibold';" />
                        <Label fx:id="lblStatus" text="Systeme operationnel" style="-fx-text-fill: #8690ad; -fx-font-size: 14;" />
                        <Label fx:id="lblDbStatus" text="Connectee" style="-fx-text-fill: #8690ad; -fx-font-size: 14;" />
                        <Label fx:id="lblLastUpdate" text="--:--" style="-fx-text-fill: #6f7c9d; -fx-font-size: 13;" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="0.0" style="-fx-background-color: #f4f6fb;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="18.0" style="-fx-background-color: white; -fx-padding: 22 28 22 28; -fx-border-color: #e6ebf2; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Label text="Gestion du Dashboard" style="-fx-font-size: 24; -fx-font-family: 'Segoe UI Semibold'; -fx-text-fill: #18243f;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField promptText="Rechercher une section..."
                                   prefWidth="360.0"
                                   style="-fx-background-color: #f3f6fb; -fx-background-radius: 28; -fx-border-radius: 28; -fx-border-color: #dde5f0; -fx-padding: 14 20; -fx-font-size: 15; -fx-text-fill: #4a5878;" />
                        <Button text="+ Nouvelle categorie" onAction="#handleAddCategorie"
                                style="-fx-background-color: #20aef3; -fx-text-fill: white; -fx-font-size: 16; -fx-font-family: 'Segoe UI Semibold'; -fx-padding: 14 26; -fx-background-radius: 28;" />
                        <Button text="Rafraichir" onAction="#handleRefresh"
                                style="-fx-background-color: white; -fx-text-fill: #5b6786; -fx-font-size: 15; -fx-padding: 13 20; -fx-background-radius: 10; -fx-border-color: #d6deea; -fx-border-radius: 10;" />
                    </children>
                </HBox>

                <Separator style="-fx-opacity: 0;" />

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding: 0;">
                    <content>
                        <VBox spacing="20.0" style="-fx-padding: 26 24 26 24; -fx-background-color: #f4f6fb;">
                            <children>
                                <HBox spacing="18.0">
                                    <children>
                                        <VBox prefWidth="250.0" spacing="12.0"
                                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 22 24; -fx-effect: dropshadow(gaussian, rgba(16,24,40,0.08), 18, 0.15, 0, 4);">
                                            <children>
                                                <Label text="Categories" style="-fx-text-fill: #74819d; -fx-font-size: 15;" />
                                                <Label fx:id="lblCategoriesCount" text="0" style="-fx-text-fill: #17233d; -fx-font-size: 38; -fx-font-family: 'Segoe UI Semibold';" />
                                                <Button text="Gerer" onAction="#handleCategories"
                                                        maxWidth="Infinity"
                                                        style="-fx-background-color: #eef7ff; -fx-text-fill: #1ca7ed; -fx-font-size: 14; -fx-padding: 10 16; -fx-background-radius: 12;" />
                                            </children>
                                        </VBox>

                                        <VBox prefWidth="250.0" spacing="12.0"
                                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 22 24; -fx-effect: dropshadow(gaussian, rgba(16,24,40,0.08), 18, 0.15, 0, 4);">
                                            <children>
                                                <Label text="Objets" style="-fx-text-fill: #74819d; -fx-font-size: 15;" />
                                                <Label fx:id="lblObjetsCount" text="0" style="-fx-text-fill: #17233d; -fx-font-size: 38; -fx-font-family: 'Segoe UI Semibold';" />
                                                <Button text="Gerer" onAction="#handleObjets"
                                                        maxWidth="Infinity"
                                                        style="-fx-background-color: #eef7ff; -fx-text-fill: #1ca7ed; -fx-font-size: 14; -fx-padding: 10 16; -fx-background-radius: 12;" />
                                            </children>
                                        </VBox>

                                        <VBox prefWidth="250.0" spacing="12.0"
                                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 22 24; -fx-effect: dropshadow(gaussian, rgba(16,24,40,0.08), 18, 0.15, 0, 4);">
                                            <children>
                                                <Label text="Medias" style="-fx-text-fill: #74819d; -fx-font-size: 15;" />
                                                <Label fx:id="lblMediasCount" text="0" style="-fx-text-fill: #17233d; -fx-font-size: 38; -fx-font-family: 'Segoe UI Semibold';" />
                                                <Button text="Gerer" onAction="#handleMedias"
                                                        maxWidth="Infinity"
                                                        style="-fx-background-color: #eef7ff; -fx-text-fill: #1ca7ed; -fx-font-size: 14; -fx-padding: 10 16; -fx-background-radius: 12;" />
                                            </children>
                                        </VBox>

                                        <VBox HBox.hgrow="ALWAYS" spacing="12.0"
                                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 22 24; -fx-effect: dropshadow(gaussian, rgba(16,24,40,0.08), 18, 0.15, 0, 4);">
                                            <children>
                                                <Label text="Actions rapides" style="-fx-text-fill: #17233d; -fx-font-size: 18; -fx-font-family: 'Segoe UI Semibold';" />
                                                <HBox spacing="12.0">
                                                    <children>
                                                        <Button text="Ajouter objet" onAction="#handleAddObjet"
                                                                style="-fx-background-color: #20aef3; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 10 16; -fx-background-radius: 12;" />
                                                        <Button text="Ajouter media" onAction="#handleAddMedia"
                                                                style="-fx-background-color: #f3f7fc; -fx-text-fill: #56637f; -fx-font-size: 14; -fx-padding: 10 16; -fx-background-radius: 12;" />
                                                        <Button text="Accueil" onAction="#handleHome"
                                                                style="-fx-background-color: #f3f7fc; -fx-text-fill: #56637f; -fx-font-size: 14; -fx-padding: 10 16; -fx-background-radius: 12;" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox spacing="20.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS" spacing="16.0"
                                              style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 22 24; -fx-effect: dropshadow(gaussian, rgba(16,24,40,0.08), 18, 0.15, 0, 4);">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Statistiques des categories" style="-fx-text-fill: #17233d; -fx-font-size: 22; -fx-font-family: 'Segoe UI Semibold';" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Button text="Rapports" onAction="#handleReports"
                                                                style="-fx-background-color: #f3f7fc; -fx-text-fill: #5c6784; -fx-font-size: 14; -fx-padding: 9 16; -fx-background-radius: 10;" />
                                                    </children>
                                                </HBox>
                                                <PieChart fx:id="categoriesPieChart" labelsVisible="true" legendVisible="true" prefHeight="420.0" />
                                            </children>
                                        </VBox>

                                        <VBox prefWidth="360.0" spacing="18.0"
                                              style="-fx-background-color: transparent;">
                                            <children>
                                                <VBox spacing="10.0"
                                                      style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 22 24; -fx-effect: dropshadow(gaussian, rgba(16,24,40,0.08), 18, 0.15, 0, 4);">
                                                    <children>
                                                        <Label text="Etat du systeme" style="-fx-text-fill: #17233d; -fx-font-size: 20; -fx-font-family: 'Segoe UI Semibold';" />
                                                        <Label text="Base de donnees" style="-fx-text-fill: #8b95ad; -fx-font-size: 13;" />
                                                        <Label fx:id="lblDbStatus" text="Connectee" style="-fx-text-fill: #1ca768; -fx-font-size: 16; -fx-font-family: 'Segoe UI Semibold';" />
                                                        <Label text="Derniere mise a jour" style="-fx-text-fill: #8b95ad; -fx-font-size: 13;" />
                                                        <Label fx:id="lblLastUpdate" text="--:--" style="-fx-text-fill: #17233d; -fx-font-size: 16; -fx-font-family: 'Segoe UI Semibold';" />
                                                        <Label text="Statut" style="-fx-text-fill: #8b95ad; -fx-font-size: 13;" />
                                                        <Label fx:id="lblStatus" text="Systeme operationnel" style="-fx-text-fill: #17233d; -fx-font-size: 16; -fx-font-family: 'Segoe UI Semibold';" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>
