<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="400.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 10;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.otemps.controller.ChatbotController">
    <top>
       <VBox alignment="CENTER" prefHeight="70.0" style="-fx-background-color: #0f172a;">
          <children>
             <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="🤖 Assistant OTEMPS" />
             <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;" text="Expert Local" />
          </children>
       </VBox>
    </top>
    <center>
       <VBox spacing="0" BorderPane.alignment="CENTER">
          <children>
             <!-- Suggestion area -->
             <VBox spacing="5" style="-fx-background-color: #f1f5f9; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                 <children>
                     <Label text="Suggestions :" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                     <javafx.scene.layout.FlowPane fx:id="suggestionsPane" hgap="5" vgap="5" />
                 </children>
             </VBox>
             
             <ScrollPane fx:id="chatScroll" fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                <content>
                   <VBox fx:id="chatBox" spacing="15.0" style="-fx-background-color: #f8fafc; -fx-padding: 15;" />
                </content>
             </ScrollPane>
          </children>
       </VBox>
    </center>

   <bottom>
      <HBox alignment="CENTER" prefHeight="60.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 10;" BorderPane.alignment="CENTER">
         <children>
            <TextField fx:id="inputField" onAction="#handleSend" prefHeight="40.0" promptText="Demandez une recommandation..." style="-fx-background-color: #f1f5f9; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #cbd5e1; -fx-padding: 0 15;" HBox.hgrow="ALWAYS" />
            <Button fx:id="sendBtn" mnemonicParsing="false" onAction="#handleSend" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #10b981; -fx-background-radius: 20; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="➔" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
