<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="500.0" spacing="15.0" style="-fx-background-color: white;" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.otemps.controller.AdminEventFormController">
   <children>
      <Label fx:id="formTitle" styleClass="page-title" text="Nouvel Événement" />
      
      <VBox spacing="5.0">
         <children>
            <Label text="Titre" />
            <TextField fx:id="titreField" promptText="Ex: Visite guidée..." styleClass="search-field" />
         </children>
      </VBox>
      
      <HBox spacing="15.0">
         <children>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Lieu" />
                  <HBox spacing="5.0">
                     <children>
                        <TextField fx:id="lieuField" promptText="Saisir ou utiliser la carte..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleOpenMap" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="📍 Carte" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="5.0" prefWidth="120.0">
               <children>
                  <Label text="Nb Places" />
                  <TextField fx:id="nbPlacesField" promptText="20" styleClass="search-field" />
               </children>
            </VBox>
         </children>
      </HBox>
      
      <HBox spacing="15.0">
         <children>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Date Début" />
                  <DatePicker fx:id="dateDebutPicker" maxWidth="1.7976931348623157E308" />
               </children>
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Date Fin" />
                  <DatePicker fx:id="dateFinPicker" maxWidth="1.7976931348623157E308" />
               </children>
            </VBox>
         </children>
      </HBox>
      
      <VBox spacing="5.0">
         <children>
            <Label text="Description" />
            <TextArea fx:id="descriptionArea" prefHeight="100.0" promptText="Décrivez l'événement en quelques mots..." style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 5;" />
         </children>
      </VBox>
      
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b;" styleClass="btn-primary" text="Annuler" />
            <Button mnemonicParsing="false" onAction="#handleSave" styleClass="btn-primary" text="Enregistrer" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
</VBox>
